<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="page-shell">
  <div class="page-heading"><div><p class="eyebrow"><%= t('administration') %></p><h1><%= t('userAccounts') %></h1></div></div>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <section class="admin-layout">
    <form method="post" action="/admin/users" enctype="multipart/form-data" class="form-panel"><h2><%= t('createAccount') %></h2><label><%= t('fullName') %><input class="form-control" name="name" required></label><label><%= t('emailAddress') %><input class="form-control" type="email" name="email" autocomplete="email" required></label><label><%= t('mobile') %><input class="form-control" name="mobile" type="tel" autocomplete="tel" required></label><label><%= t('temporaryPassword') %><input class="form-control" type="password" name="password" minlength="8" autocomplete="new-password" required></label><label><%= t('profilePicture') %><input class="form-control" name="profilePicture" type="file" accept="image/jpeg,image/png,image/webp" required></label><button class="btn btn-primary"><%= t('createUser') %></button></form>
    <div class="table-panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th><%= t('profilePicture') %></th><th><%= t('name') %></th><th><%= t('emailAddress') %></th><th><%= t('mobile') %></th><th><%= t('role') %></th><th><%= t('status') %></th><th></th></tr></thead><tbody><% users.forEach(user => { %><tr><td><% if (user.profile_picture) { %><img src="/profiles/<%= user._id %>" alt="" class="rounded-circle" width="40" height="40" style="object-fit:cover"><% } %></td><td><%= user.name %></td><td><%= user.email %></td><td><%= user.mobile || '-' %></td><td><%= user.role %></td><td><span class="status-label"><%= user.active ? t('active') : t('disabled') %></span></td><td><% if (user.role !== 'admin') { %><form method="post" action="/admin/users/<%= user._id %>/toggle"><button class="text-button"><%= user.active ? t('disable') : t('enable') %></button></form><% } %></td></tr><% }) %></tbody></table></div></div>
  </section>
</main></body></html>
