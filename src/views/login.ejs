<%- include('partials/head') %>
<main class="auth-shell login-shell">
  <section class="auth-panel login-panel" aria-labelledby="login-title">
    <form method="post" action="/language" class="language-switch login-language"><select name="locale" aria-label="<%= t('language') %>" onchange="this.form.submit()"><option value="fr" <%= locale === 'fr' ? 'selected' : '' %>>FR</option><option value="en" <%= locale === 'en' ? 'selected' : '' %>>EN</option></select></form>
    <div class="login-brand">
      <img class="brand-mark large" src="/assets/mdai-logo.png" alt="" aria-hidden="true">
      <span>Point.share MDai</span>
    </div>
    <div class="login-heading">
      <p class="eyebrow"><%= t('privateWorkspace') %></p>
      <h1 id="login-title"><%= t('welcomeBack') %></h1>
      <p class="muted"><%= t('loginPrompt') %></p>
    </div>
    <% if (error) { %><div class="alert alert-danger login-alert" role="alert" aria-live="polite"><%= error %></div><% } %>
    <form method="post" action="/login" class="stack-form login-form">
      <label for="login-email"><%= t('emailAddress') %></label>
      <input class="form-control" id="login-email" type="email" name="email" value="<%= typeof email === 'string' ? email : '' %>" autocomplete="username" inputmode="email" required autofocus>
      <label for="login-password"><%= t('password') %></label>
      <input class="form-control" id="login-password" type="password" name="password" autocomplete="current-password" required>
      <button class="btn btn-primary w-100 login-submit" type="submit"><%= t('signIn') %></button>
    </form>
  </section>
</main>
</body></html>
