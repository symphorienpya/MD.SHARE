<%- include('partials/head') %><%- include('partials/nav') %>
<main class="chat-shell team-chat-shell">
  <aside class="people-panel">
    <div class="team-panel-heading">
      <% if (team.logo) { %><img src="/team-logo/<%= team._id %>" alt="" class="team-logo large"><% } else { %><span class="team-logo team-logo-fallback large"><%= team.name.charAt(0).toUpperCase() %></span><% } %>
      <h1><%= team.name %></h1>
    </div>
    <p class="eyebrow"><%= t('connectedTeam') %></p>
    <% users.forEach(user => { %><div class="person-row"><span class="status-dot"></span><div><strong><%= user.name %></strong><small><%= user.role %></small></div></div><% }) %>
  </aside>
  <section class="conversation">
    <div class="conversation-header"><div><p class="eyebrow"><%= locale === 'fr' ? 'Équipe privée' : 'Private team' %></p><h1><%= team.name %></h1></div><span id="teamConnectionState" class="connection-state"><%= t('connecting') %></span></div>
    <div id="messageList" class="message-list" data-team-id="<%= team._id %>" aria-live="polite">
      <% messages.forEach(message => { %><article class="message<%= String(message.sender._id) === String(currentUser.id) ? ' own' : '' %>"><strong><%= message.sender.name %></strong><p><%= message.body %></p><time><%= message.createdAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></time></article><% }) %>
    </div>
    <form id="teamChatForm" class="chat-form"><input id="teamChatInput" class="form-control" maxlength="2000" placeholder="<%= t('writeMessage') %>" autocomplete="off"><button class="btn btn-primary" type="submit"><%= t('send') %></button></form>
    <form id="teamFileForm" class="chat-form" enctype="multipart/form-data">
      <input class="form-control" type="file" name="file" required>
      <button class="btn btn-primary" type="submit"><%= locale === 'fr' ? 'Partager le fichier' : 'Share file' %></button>
    </form>
  </section>
</main>
</body></html>
