<%- include('partials/head') %>
<main class="auth-shell">
  <section class="auth-panel narrow">
    <p class="eyebrow"><%= t('accountSetup') %></p>
    <h1><%= t('newPassword') %></h1>
    <p class="muted"><%= t('passwordSecurity') %></p>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="post" action="/change-password" class="stack-form">
      <label><%= t('newPassword') %><input class="form-control" type="password" name="password" minlength="8" autocomplete="new-password" required></label>
      <label><%= t('confirmPassword') %><input class="form-control" type="password" name="confirmPassword" minlength="8" autocomplete="new-password" required></label>
      <button class="btn btn-primary w-100" type="submit"><%= t('updatePassword') %></button>
    </form>
  </section>
</main>
</body></html>
