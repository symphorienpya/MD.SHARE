<header class="app-header">
  <img class="brand-mark" src="/assets/mdai-logo.png" alt="">
  <a class="brand" href="/dashboard">Point.share <strong>MDai</strong></a>
  <nav class="main-nav" aria-label="Primary navigation">
    <a href="/dashboard"><%= t('resources') %></a>
    <a href="/chat"><%= t('teamChat') %></a>
    <% if (currentUser && currentUser.role === 'admin') { %><a href="/admin"><%= t('administration') %></a><% } %>
  </nav>
  <div class="account-menu">
    <button type="button" class="header-icon" id="messageInboxButton" aria-label="<%= locale === 'fr' ? 'Messages' : 'Messages' %>">💬<span class="header-badge" id="messageBadge" hidden>0</span></button>
    <button type="button" class="header-icon" id="notificationInboxButton" aria-label="<%= locale === 'fr' ? 'Notifications' : 'Notifications' %>">🔔<span class="header-badge" id="notificationBadge" hidden>0</span></button>
    <form method="post" action="/language" class="language-switch"><select name="locale" aria-label="<%= t('language') %>" onchange="this.form.submit()"><option value="fr" <%= locale === 'fr' ? 'selected' : '' %>>FR</option><option value="en" <%= locale === 'en' ? 'selected' : '' %>>EN</option></select></form>
    <span><%= currentUser.name %></span>
    <form method="post" action="/logout"><button class="text-button" type="submit"><%= t('signOut') %></button></form>
  </div>
</header>
<dialog class="inbox-dialog" id="inboxDialog" aria-labelledby="inboxTitle">
  <div class="inbox-panel">
    <div class="card-heading">
      <div><p class="eyebrow" id="inboxEyebrow"></p><h2 id="inboxTitle"></h2></div>
      <button type="button" class="icon-button" id="closeInbox" aria-label="Close">×</button>
    </div>
    <div id="inboxContent" class="inbox-content"></div>
  </div>
</dialog>
<script>window.CURRENT_USER_ID="<%= String(currentUser.id) %>";</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/app.js"></script>
